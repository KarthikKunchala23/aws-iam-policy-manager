{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowScopedEC2InstanceAccessActions",
            "Effect": "Allow",
            "Action": [
                "ec2:RunInstances",
                "ec2:CreateFleet"
            ],
            "Resource": [
                "arn:aws:ec2:ap-south-1::image/*",
                "arn:aws:ec2:ap-south-1::snapshot/*",
                "arn:aws:ec2:ap-south-1:897722700244:security-group/*",
                "arn:aws:ec2:ap-south-1:897722700244:subnet/*",
                "arn:aws:ec2:ap-south-1:897722700244:capacity-reservation/*"
            ]
        },
        {
            "Sid": "AllowScopedEC2LaunchTemplateAccessActions",
            "Effect": "Allow",
            "Action": [
                "ec2:RunInstances",
                "ec2:CreateFleet"
            ],
            "Resource": [
                "arn:aws:ec2:ap-south-1:897722700244:launch-template/*"
            ],
            "Condition": {
                "StringEquals": {
                    "aws:ResourceTag/kubernetes.io/cluster/gp-eks-dev-cluster": "owned"
                },
                "StringLike": {
                    "aws:ResourceTag/karpenter.sh/nodepool": "*"
                }
            }
        },
        {
            "Sid": "AllowScopedEC2InstanceActionsWithTags",
            "Effect": "Allow",
            "Action": [
                "ec2:RunInstances",
                "ec2:CreateFleet",
                "ec2:CreateLaunchTemplate"
            ],
            "Resource": [
                "arn:aws:ec2:ap-south-1:897722700244:fleet/*",
                "arn:aws:ec2:ap-south-1:897722700244:instance/*",
                "arn:aws:ec2:ap-south-1:897722700244:volume/*",
                "arn:aws:ec2:ap-south-1:897722700244:network-interface/*",
                "arn:aws:ec2:ap-south-1:897722700244:launch-template/*",
                "arn:aws:ec2:ap-south-1:897722700244:spot-instances-request/*",
                "arn:aws:ec2:ap-south-1:897722700244:capacity-reservation/*"
            ],
            "Condition": {
                "StringEquals": {
                    "aws:RequestTag/kubernetes.io/cluster/gp-eks-dev-cluster": "owned",
                    "aws:RequestTag/eks:eks-cluster-name": "gp-eks-dev-cluster"
                },
                "StringLike": {
                    "aws:RequestTag/karpenter.sh/nodepool": "*"
                }
            }
        },
        {
            "Sid": "AllowScopedResourceCreationTagging",
            "Effect": "Allow",
            "Action": [
                "ec2:CreateTags"
            ],
            "Resource": [
                "arn:aws:ec2:ap-south-1:897722700244:fleet/*",
                "arn:aws:ec2:ap-south-1:897722700244:instance/*",
                "arn:aws:ec2:ap-south-1:897722700244:volume/*",
                "arn:aws:ec2:ap-south-1:897722700244:network-interface/*",
                "arn:aws:ec2:ap-south-1:897722700244:launch-template/*",
                "arn:aws:ec2:ap-south-1:897722700244:spot-instances-request/*"
            ],
            "Condition": {
                "StringEquals": {
                    "aws:RequestTag/kubernetes.io/cluster/gp-eks-dev-cluster": "owned",
                    "aws:RequestTag/eks:eks-cluster-name": "gp-eks-dev-cluster",
                    "ec2:CreateAction": [
                        "RunInstances",
                        "CreateFleet",
                        "CreateLaunchTemplate"
                    ]
                },
                "StringLike": {
                    "aws:RequestTag/karpenter.sh/nodepool": "*"
                }
            }
        },
        {
            "Sid": "AllowScopedResourceTagging",
            "Effect": "Allow",
            "Action": [
                "ec2:CreateTags"
            ],
            "Resource": [
                "arn:aws:ec2:ap-south-1:897722700244:instance/*"
            ],
            "Condition": {
                "StringEquals": {
                    "aws:ResourceTag/kubernetes.io/cluster/gp-eks-dev-cluster": "owned"
                },
                "StringLike": {
                    "aws:ResourceTag/karpenter.sh/nodepool": "*"
                },
                "StringEqualsIfExists": {
                    "aws:RequestTag/eks:eks-cluster-name": "gp-eks-dev-cluster"
                },
                "ForAllValues:StringEquals": {
                    "aws:TagKeys": [
                        "eks:eks-cluster-name",
                        "karpenter.sh/nodeclaim",
                        "Name"
                    ]
                }
            }
        },
        {
            "Sid": "AllowScopedDeletion",
            "Effect": "Allow",
            "Action": [
                "ec2:TerminateInstances",
                "ec2:DeleteLaunchTemplate"
            ],
            "Resource": [
                "arn:aws:ec2:ap-south-1:897722700244:instance/*",
                "arn:aws:ec2:ap-south-1:897722700244:launch-template/*"
            ],
            "Condition": {
                "StringEquals": {
                    "aws:ResourceTag/kubernetes.io/cluster/gp-eks-dev-cluster": "owned"
                },
                "StringLike": {
                    "aws:ResourceTag/karpenter.sh/nodepool": "*"
                }
            }
        }
    ]
}