{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowScopedEC2InstanceAccessActions",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateFleet"
      ],
      "Resource": [
        "arn:aws:ec2:{{ region }}::image/*",
        "arn:aws:ec2:{{ region }}::snapshot/*",
        "arn:aws:ec2:{{ region }}:{{ account }}:security-group/*",
        "arn:aws:ec2:{{ region }}:{{ account }}:subnet/*",
        "arn:aws:ec2:{{ region }}:{{ account }}:capacity-reservation/*"
      ]
    },
    {
      "Sid": "AllowScopedEC2LaunchTemplateAccessActions",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateFleet"
      ],
      "Resource": [
        "arn:aws:ec2:{{ region }}:{{ account }}:launch-template/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/kubernetes.io/cluster/gp-eks-{{ environment }}-cluster": "owned"
        },
        "StringLike": {
          "aws:ResourceTag/karpenter.sh/nodepool": "*"
        }
      }
    },
    {
      "Sid": "AllowScopedEC2InstanceActionsWithTags",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateFleet",
        "ec2:CreateLaunchTemplate"
      ],
      "Resource": [
        "arn:aws:ec2:{{ region }}:{{ account }}:fleet/*",
        "arn:aws:ec2:{{ region }}:{{ account }}:instance/*",
        "arn:aws:ec2:{{ region }}:{{ account }}:volume/*",
        "arn:aws:ec2:{{ region }}:{{ account }}:network-interface/*",
        "arn:aws:ec2:{{ region }}:{{ account }}:launch-template/*",
        "arn:aws:ec2:{{ region }}:{{ account }}:spot-instances-request/*",
        "arn:aws:ec2:{{ region }}:{{ account }}:capacity-reservation/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/kubernetes.io/cluster/gp-eks-{{ environment }}-cluster": "owned",
          "aws:RequestTag/eks:eks-cluster-name": "gp-eks-{{ environment }}-cluster"
        },
        "StringLike": {
          "aws:RequestTag/karpenter.sh/nodepool": "*"
        }
      }
    },
    {
      "Sid": "AllowScopedResourceCreationTagging",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": [
        "arn:aws:ec2:{{ region }}:{{ account }}:fleet/*",
        "arn:aws:ec2:{{ region }}:{{ account }}:instance/*",
        "arn:aws:ec2:{{ region }}:{{ account }}:volume/*",
        "arn:aws:ec2:{{ region }}:{{ account }}:network-interface/*",
        "arn:aws:ec2:{{ region }}:{{ account }}:launch-template/*",
        "arn:aws:ec2:{{ region }}:{{ account }}:spot-instances-request/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/kubernetes.io/cluster/gp-eks-{{ environment }}-cluster": "owned",
          "aws:RequestTag/eks:eks-cluster-name": "gp-eks-{{ environment }}-cluster",
          "ec2:CreateAction": [
            "RunInstances",
            "CreateFleet",
            "CreateLaunchTemplate"
          ]
        },
        "StringLike": {
          "aws:RequestTag/karpenter.sh/nodepool": "*"
        }
      }
    },
    {
      "Sid": "AllowScopedResourceTagging",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": [
        "arn:aws:ec2:{{ region }}:{{ account }}:instance/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/kubernetes.io/cluster/gp-eks-{{ environment }}-cluster": "owned"
        },
        "StringLike": {
          "aws:ResourceTag/karpenter.sh/nodepool": "*"
        },
        "StringEqualsIfExists": {
          "aws:RequestTag/eks:eks-cluster-name": "gp-eks-{{ environment }}-cluster"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "eks:eks-cluster-name",
            "karpenter.sh/nodeclaim",
            "Name"
          ]
        }
      }
    },
    {
      "Sid": "AllowScopedDeletion",
      "Effect": "Allow",
      "Action": [
        "ec2:TerminateInstances",
        "ec2:DeleteLaunchTemplate"
      ],
      "Resource": [
        "arn:aws:ec2:{{ region }}:{{ account }}:instance/*",
        "arn:aws:ec2:{{ region }}:{{ account }}:launch-template/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/kubernetes.io/cluster/gp-eks-{{ environment }}-cluster": "owned"
        },
        "StringLike": {
          "aws:ResourceTag/karpenter.sh/nodepool": "*"
        }
      }
    }
  ]
}